      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Identidade validada por BE-004; esta API não emite nem valida JWT sem o adapter."
      }
    },
    "schemas": {
      "DraftInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "summary",
          "provenance"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "provenance": {
            "$ref": "#/components/schemas/ProvenanceInput"
          }
        }
      },
      "ProvenanceInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceReference",
          "responsibleReference",
          "periodStart",
          "periodEnd"
        ],
        "properties": {
          "sourceReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "responsibleReference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "periodStart": {
            "type": "string",
            "format": "date"
          },
          "periodEnd": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "PublicationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PublicResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "title",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "VersionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "title",
          "summary",
          "approved"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          }
        }
      },
      "ManagementResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "revision",
          "publishedVersion",
          "latestVersion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "publishedVersion": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "latestVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ProvenanceResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "sourceReference",
          "responsibleReference",
          "periodStart",
          "periodEnd",
          "createdBy",
          "createdAt",
          "approvedBy",
          "approvedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "sourceReference": {
            "type": "string"
          },
          "responsibleReference": {
            "type": "string"
          },
          "periodStart": {
            "type": "string",
            "format": "date"
          },
          "periodEnd": {
            "type": "string",
            "format": "date"
          },
          "createdBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "approvedBy": {
            "type": [
              "string",
              "null"
            ]
          },
          "approvedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "HistoryResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "size",
          "totalElements"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revision",
                "action",
                "version",
                "actor",
                "at",
                "correlationId",
                "impactId",
                "result"
              ],
              "properties": {
                "revision": {
                  "type": "integer"
                },
                "action": {
                  "type": "string",
                  "enum": [
                    "CREATE",
                    "REVISE",
                    "APPROVE",
                    "PUBLISH",
                    "WITHDRAW"
                  ]
                },
                "version": {
                  "type": "integer"
                },
                "actor": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "correlationId": {
                  "type": "string"
                },
                "impactId": {
                  "type": "string",
                  "format": "uuid"
                },
                "result": {
                  "type": "string",
                  "const": "SUCCESS"
                }
              }
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "correlationId"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        }
      },
      "VersionsPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "page",
          "size",
          "totalElements"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersionResponse"
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
