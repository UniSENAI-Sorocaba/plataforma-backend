# Defaults mínimos da OWASP Password Storage Cheat Sheet.
# Parâmetros a calibrar no ambiente alvo antes de produção.
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
ARGON2_SALT_LENGTH=16
ARGON2_HASH_LENGTH=32
# Configure localmente em .env (arquivo ignorado pelo Git) para iniciar o Compose.
DB_PASSWORD=
